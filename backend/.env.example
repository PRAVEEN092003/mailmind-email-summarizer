# FastAPI Backend Environment Configuration — EXAMPLE FILE
# Copy to .env and fill in your values.

PROJECT_NAME="Intelligent Email Thread Summarizer"
API_V1_STR="/api"

# Deployment environment: "development" (default) or "production"
# Set to "production" to enforce strong JWT secrets and INFO-level logging.
ENVIRONMENT=development

# Ollama AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=90
# Cap simultaneous Ollama calls to protect laptop CPU/RAM
OLLAMA_MAX_CONCURRENT=2

# Input and Upload limits
MAX_INPUT_CHARS=35000
MAX_UPLOAD_SIZE_BYTES=10485760

# Authentication & Security
# REQUIRED: Replace with a strong random secret (minimum 32 characters).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Password requirements enforced at registration
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_SPECIAL=false

# Rate limiting — login (brute-force protection)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Rate limiting — AI summarization
RATE_LIMIT_SUMMARIZE_MAX=20
RATE_LIMIT_SUMMARIZE_WINDOW_SECONDS=3600

# Rate limiting — general API requests
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60

# CORS — comma-separated origins or JSON array
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database
DATABASE_URL=sqlite:///./email_summarizer.db
